@model ECommerce.Application.Catalog.Admin.CategoryEditModel

<div class="admin-page-head">
    <h1 class="text-page-title">Edit category</h1>
    <a class="btn btn-ghost" href="/c/@Model.Slug" target="_blank"><icon name="external-link" class="icon--sm" /> View in store</a>
</div>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <partial name="_Form" model="Model" />
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
