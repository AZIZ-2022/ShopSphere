@model ECommerce.Application.Catalog.Admin.ProductEditModel

<div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small"></div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel">
            <p class="text-eyebrow mb-3">Basic info</p>
            <div class="mb-3">
                <label class="form-label">Name <span class="required-mark">*</span></label>
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>
            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label class="form-label">SKU <span class="required-mark">*</span></label>
                    <input asp-for="Sku" class="form-control" />
                    <span asp-validation-for="Sku" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Slug <span class="text-muted">(optional)</span></label>
                    <input asp-for="Slug" class="form-control" placeholder="auto" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Short description</label>
                <input asp-for="ShortDescription" class="form-control" maxlength="500" />
            </div>
            <div class="mb-0">
                <label class="form-label">Description <span class="text-muted">(HTML allowed)</span></label>
                <textarea asp-for="Description" class="form-control" rows="6"></textarea>
            </div>
        </div>

        <div class="panel">
            <h2 class="text-card-title mb-3"><icon name="image" class="icon--sm" /> Images</h2>
            @if (Model.Images.Count > 0)
            {
                <div class="img-manager">
                    @foreach (var img in Model.Images)
                    {
                        <div class="img-manager__item @(img.IsMain ? "is-main" : "")">
                            <img src="@img.ImageUrl" alt="@img.AltText" />
                            <div class="img-manager__actions">
                                @if (!img.IsMain)
                                {
                                    <form asp-action="SetMainImage" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@Model.Id" />
                                        <input type="hidden" name="imageId" value="@img.Id" />
                                        <button type="submit" class="btn btn-ghost btn-xs">Set main</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="chip-flag">Main</span>
                                }
                                <form asp-action="DeleteImage" method="post" onsubmit="return confirm('Remove this image?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="imageId" value="@img.Id" />
                                    <button type="submit" class="btn btn-danger-ghost btn-xs btn-icon-only"><icon name="delete" class="icon--sm" /></button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small">No images yet.</p>
            }
            <div class="mt-3">
                <label class="form-label">Add images <span class="text-muted">(JPG/PNG/WebP, max 3 MB each)</span></label>
                <input type="file" name="images" class="form-control" multiple accept="image/*" />
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel">
            <p class="text-eyebrow mb-3">Organization</p>
            <div class="mb-3">
                <label class="form-label">Category <span class="required-mark">*</span></label>
                <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
                    <option value="">— choose —</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Brand <span class="text-muted">(optional)</span></label>
                <select asp-for="BrandId" asp-items="ViewBag.Brands" class="form-select">
                    <option value="">— none —</option>
                </select>
            </div>
            <div class="row g-3">
                <div class="col-6 mb-3">
                    <label class="form-label">Price <span class="required-mark">*</span></label>
                    <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>
                <div class="col-6 mb-3">
                    <label class="form-label">Discount price</label>
                    <input asp-for="DiscountPrice" type="number" step="0.01" min="0" class="form-control" placeholder="—" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Stock quantity</label>
                <input asp-for="StockQuantity" type="number" min="0" class="form-control" />
            </div>
            <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active (visible)</label></div>
            <div class="form-check"><input asp-for="IsFeatured" class="form-check-input" /><label asp-for="IsFeatured" class="form-check-label">Featured</label></div>
            <div class="form-check"><input asp-for="IsNewArrival" class="form-check-input" /><label asp-for="IsNewArrival" class="form-check-label">New arrival</label></div>
        </div>
        <div class="panel">
            <p class="text-eyebrow mb-3">SEO <span class="text-muted">(optional)</span></p>
            <div class="mb-3">
                <label class="form-label">Meta title</label>
                <input asp-for="MetaTitle" class="form-control" maxlength="200" placeholder="@Model.Name" />
            </div>
            <div class="mb-0">
                <label class="form-label">Meta description</label>
                <textarea asp-for="MetaDescription" class="form-control" rows="2" maxlength="300"></textarea>
            </div>
        </div>
        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary"><icon name="save" class="icon--sm" /> Save</button>
            <a class="btn btn-ghost" asp-action="Index"><icon name="close" class="icon--sm" /> Cancel</a>
        </div>
    </div>
</div>
