@model ECommerce.Application.Orders.CouponEditModel
@using ECommerce.Domain.Enums

<div asp-validation-summary="All" class="alert alert-danger py-2 px-3 small"></div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="panel">
            <p class="text-eyebrow mb-3">Coupon</p>
            <div class="mb-3">
                <label class="form-label">Code <span class="required-mark">*</span></label>
                <input asp-for="Code" class="form-control text-uppercase" autofocus maxlength="40" placeholder="WELCOME10" />
                <span asp-validation-for="Code" class="text-danger small"></span>
            </div>
            <div class="mb-0">
                <label class="form-label">Description <span class="text-muted">(internal note, optional)</span></label>
                <input asp-for="Description" class="form-control" maxlength="300" />
            </div>
        </div>

        <div class="panel">
            <p class="text-eyebrow mb-3">Discount</p>
            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Type</label>
                    <select asp-for="DiscountType" class="form-select" asp-items="Html.GetEnumSelectList<DiscountType>()"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Value <span class="required-mark">*</span></label>
                    <input asp-for="DiscountValue" type="number" step="0.01" min="0.01" class="form-control" />
                    <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Minimum order amount</label>
                    <input asp-for="MinOrderAmount" type="number" step="0.01" min="0" class="form-control" />
                    <p class="field-hint">Base currency. 0 means no minimum.</p>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Max discount cap <span class="text-muted">(optional)</span></label>
                    <input asp-for="MaxDiscountAmount" type="number" step="0.01" min="0" class="form-control" placeholder="—" />
                    <p class="field-hint">Useful to cap a percentage discount.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="panel">
            <p class="text-eyebrow mb-3">Validity</p>
            <div class="mb-3">
                <label class="form-label">Starts</label>
                <input asp-for="StartsAt" type="datetime-local" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Ends</label>
                <input asp-for="EndsAt" type="datetime-local" class="form-control" />
                <span asp-validation-for="EndsAt" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Usage limit <span class="text-muted">(optional)</span></label>
                <input asp-for="UsageLimit" type="number" min="1" class="form-control" placeholder="Unlimited" />
                @if (Model.Id != 0)
                {
                    <p class="field-hint">Used @Model.UsedCount time(s) so far.</p>
                }
            </div>
            <div class="form-check"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Active</label></div>
        </div>
        <div class="d-grid gap-2">
            <button type="submit" class="btn btn-primary"><icon name="save" class="icon--sm" /> Save</button>
            <a class="btn btn-ghost" asp-action="Index"><icon name="close" class="icon--sm" /> Cancel</a>
        </div>
    </div>
</div>
