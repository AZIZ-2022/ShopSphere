@model ECommerce.Application.Common.Models.PagedResult<ECommerce.Application.Orders.OrderListItemDto>
@using ECommerce.Domain.Enums
@{
    var search = ViewData["Search"] as string;
    var status = ViewData["Status"] as OrderStatus?;
    string PageUrl(int p)
    {
        var qs = $"page={p}";
        if (!string.IsNullOrWhiteSpace(search)) qs += $"&q={Uri.EscapeDataString(search)}";
        if (status is not null) qs += $"&status={status}";
        return $"/Admin/Orders?{qs}";
    }
}

<div class="admin-page-head">
    <h1 class="text-page-title">Orders <span class="text-muted-sm">(@Model.TotalCount)</span></h1>
</div>

<form method="get" class="admin-search">
    <input type="search" name="q" value="@search" placeholder="Order number, customer name or email…" class="form-control" />
    <select name="status" class="form-select" style="max-width:180px">
        <option value="">All statuses</option>
        @foreach (var s in Enum.GetValues<OrderStatus>())
        {
            <option value="@s" selected="@(status == s)">@s</option>
        }
    </select>
    <button class="btn btn-ghost" type="submit"><icon name="search" class="icon--sm" /> Filter</button>
    @if (!string.IsNullOrWhiteSpace(search) || status is not null)
    {
        <a class="btn btn-ghost" asp-action="Index"><icon name="close" class="icon--sm" /> Clear</a>
    }
</form>

<div class="panel p-0">
    <table class="admin-table">
        <thead><tr><th>Order</th><th>Date</th><th>Customer</th><th class="num">Items</th><th class="num">Total</th><th>Payment</th><th>Status</th><th class="actions"></th></tr></thead>
        <tbody>
        @if (Model.TotalCount == 0)
        {
            <tr><td colspan="8"><div class="empty-state-cell"><icon name="orders" class="icon--lg" /><span>No orders found.</span></div></td></tr>
        }
        @foreach (var o in Model.Items)
        {
            <tr>
                <td><strong>@o.OrderNumber</strong></td>
                <td class="text-muted">@o.PlacedAt.ToString("MMM d, yyyy")</td>
                <td>@o.CustomerName<br /><span class="text-muted small">@o.CustomerEmail</span></td>
                <td class="num">@o.ItemCount</td>
                <td class="num">@o.CurrencyCode @o.TotalAmount.ToString("0.00")</td>
                <td><span class="order-status @ECommerce.Web.Infrastructure.OrderUi.PaymentClass(o.PaymentStatus)">@o.PaymentStatus</span></td>
                <td><span class="order-status @ECommerce.Web.Infrastructure.OrderUi.StatusClass(o.Status)">@o.Status</span></td>
                <td class="actions"><a class="btn btn-ghost btn-sm" asp-action="Details" asp-route-id="@o.Id"><icon name="eye" class="icon--sm" /> Open</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <partial name="~/Views/Shared/_Pagination.cshtml"
             model="@(new ECommerce.Web.Models.Catalog.PagerModel(Model.Page, Model.TotalPages, PageUrl))" />
}
