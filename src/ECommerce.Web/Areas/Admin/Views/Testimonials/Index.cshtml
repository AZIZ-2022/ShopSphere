@model IReadOnlyList<ECommerce.Application.Cms.TestimonialEditModel>

<div class="admin-page-head">
    <h1 class="text-page-title">Testimonials</h1>
    <a class="btn btn-primary" asp-action="Create"><icon name="plus" class="icon--sm" /> New testimonial</a>
</div>

<div class="panel p-0">
    <table class="admin-table">
        <thead><tr><th>Customer</th><th>Message</th><th class="num">Rating</th><th class="num">Order</th><th>Status</th><th class="actions"></th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="6"><div class="empty-state-cell"><icon name="testimonials" class="icon--lg" /><span>No testimonials yet.</span></div></td></tr>
        }
        @foreach (var t in Model)
        {
            <tr>
                <td><strong>@t.CustomerName</strong><br /><span class="text-muted small">@t.Designation</span></td>
                <td class="text-muted small" style="max-width:360px">@t.Message</td>
                <td class="num">@t.Rating★</td>
                <td class="num">@t.DisplayOrder</td>
                <td>@if (t.IsActive) { <span class="badge-status on">Active</span> } else { <span class="badge-status off">Hidden</span> }</td>
                <td class="actions">
                    <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@t.Id"><icon name="edit" class="icon--sm" /> Edit</a>
                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this testimonial?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-danger-ghost btn-sm" type="submit"><icon name="delete" class="icon--sm" /> Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
