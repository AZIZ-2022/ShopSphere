@model ECommerce.Application.Common.Models.PagedResult<ECommerce.Application.Cms.SubscriberListItem>

<div class="admin-page-head">
    <h1 class="text-page-title">Newsletter subscribers <span class="text-muted-sm">(@Model.TotalCount)</span></h1>
    <a class="btn btn-ghost" asp-action="Export"><icon name="download" class="icon--sm" /> Export CSV</a>
</div>

<div class="panel p-0">
    <table class="admin-table">
        <thead><tr><th>Email</th><th>Subscribed</th><th>Status</th><th class="actions"></th></tr></thead>
        <tbody>
        @if (Model.TotalCount == 0)
        {
            <tr><td colspan="4"><div class="empty-state-cell"><icon name="subscribers" class="icon--lg" /><span>No subscribers yet.</span></div></td></tr>
        }
        @foreach (var s in Model.Items)
        {
            <tr>
                <td>@s.Email</td>
                <td class="text-muted">@s.SubscribedAt.ToString("MMM d, yyyy")</td>
                <td>@if (s.IsActive) { <span class="badge-status on">Subscribed</span> } else { <span class="badge-status off">Unsubscribed</span> }</td>
                <td class="actions">
                    <form asp-action="Toggle" asp-route-id="@s.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-ghost btn-sm" type="submit">@(s.IsActive ? "Unsubscribe" : "Re-subscribe")</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <partial name="~/Views/Shared/_Pagination.cshtml"
             model="@(new ECommerce.Web.Models.Catalog.PagerModel(Model.Page, Model.TotalPages, p => $"/Admin/Subscribers?page={p}"))" />
}
