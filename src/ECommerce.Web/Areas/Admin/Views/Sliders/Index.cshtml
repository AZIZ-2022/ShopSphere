@model IReadOnlyList<ECommerce.Application.Cms.SliderEditModel>

<div class="admin-page-head">
    <h1 class="text-page-title">Hero sliders</h1>
    <a class="btn btn-primary" asp-action="Create"><icon name="plus" class="icon--sm" /> New slide</a>
</div>

<div class="panel p-0">
    <table class="admin-table">
        <thead><tr><th></th><th>Title</th><th class="num">Order</th><th>Status</th><th class="actions"></th></tr></thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr><td colspan="5"><div class="empty-state-cell"><icon name="sliders" class="icon--lg" /><span>No slides yet.</span></div></td></tr>
        }
        @foreach (var s in Model)
        {
            <tr>
                <td class="thumb-cell">@if (!string.IsNullOrEmpty(s.ImageUrl)) { <img src="@s.ImageUrl" alt="" /> } else { <span class="thumb-empty"></span> }</td>
                <td><strong>@s.Title</strong><br /><span class="text-muted small">@s.Subtitle</span></td>
                <td class="num">@s.DisplayOrder</td>
                <td>@if (s.IsActive) { <span class="badge-status on">Active</span> } else { <span class="badge-status off">Hidden</span> }</td>
                <td class="actions">
                    <a class="btn btn-ghost btn-sm" asp-action="Edit" asp-route-id="@s.Id"><icon name="edit" class="icon--sm" /> Edit</a>
                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Delete this slide?');">
                        @Html.AntiForgeryToken()
                        <button class="btn btn-danger-ghost btn-sm" type="submit"><icon name="delete" class="icon--sm" /> Delete</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
