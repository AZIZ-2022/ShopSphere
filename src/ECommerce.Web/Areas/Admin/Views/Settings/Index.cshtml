@using ECommerce.Web.Infrastructure
@model IReadOnlyList<ECommerce.Application.Cms.SiteSettingItem>
@{
    string Group(string key) => key.Contains('.') ? key[..key.IndexOf('.')] : "General";
    var groups = Model.GroupBy(s => Group(s.Key)).OrderBy(g => g.Key);
}

<div class="admin-page-head">
    <h1 class="text-page-title">Site settings</h1>
</div>

<form asp-action="Index" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    @foreach (var g in groups)
    {
        <div class="panel">
            <h2 class="text-card-title mb-3"><icon name="settings" class="icon--sm" /> @g.Key</h2>

            @if (g.Key == "Theme")
            {
                <div class="theme-presets mb-4">
                    <p class="text-eyebrow mb-2">Quick presets</p>
                    <div class="d-flex gap-2 flex-wrap">
                        @foreach (var p in ThemeCatalog.Presets)
                        {
                            <button type="submit" name="preset" value="@p.Key" formaction="@Url.Action("ApplyPreset")" formnovalidate
                                    class="theme-preset-swatch" title="@p.Label">
                                <span style="background:@p.Primary"></span><span style="background:@p.Accent"></span>
                                <small>@p.Label</small>
                            </button>
                        }
                    </div>
                    <p class="field-hint">Applying a preset overwrites the primary/accent colours below (saved immediately).</p>
                </div>
            }

            @foreach (var s in g.OrderBy(x => x.Key))
            {
                <div class="mb-3">
                    <label class="form-label">@s.Key</label>

                    @if (s.Key is "Site.LogoUrl" or "Site.FaviconUrl")
                    {
                        var isLogo = s.Key == "Site.LogoUrl";
                        if (!string.IsNullOrEmpty(s.Value))
                        {
                            <div class="mb-2"><img src="@s.Value" alt="" style="width:@(isLogo ? 120 : 32)px;height:@(isLogo ? 48 : 32)px;object-fit:contain;border-radius:var(--radius-sm);border:1px solid var(--c-line);background:#fff" /></div>
                        }
                        <input type="hidden" name="values[@s.Key]" value="@s.Value" />
                        <input type="file" name="@(isLogo ? "logoFile" : "faviconFile")" class="form-control" accept="image/*" />
                    }
                    else if (s.Key.EndsWith("Color", StringComparison.OrdinalIgnoreCase))
                    {
                        var hex = ThemeCatalog.IsValidHex(s.Value) ? s.Value : "#2563eb";
                        <div class="d-flex align-items-center gap-2">
                            <input type="color" name="values[@s.Key]" value="@hex" class="form-control form-control-color" style="width:3rem;height:2.4rem;padding:.25rem;" />
                            <span class="text-muted-sm">@hex</span>
                        </div>
                    }
                    else if (s.Key == "Theme.FontFamily")
                    {
                        <select name="values[@s.Key]" class="form-select">
                            @foreach (var f in ThemeCatalog.Fonts)
                            {
                                <option value="@f.Key" selected="@(string.Equals(s.Value, f.Key, StringComparison.OrdinalIgnoreCase))">@f.Label</option>
                            }
                        </select>
                    }
                    else if (s.Key == "Theme.ButtonStyle")
                    {
                        <select name="values[@s.Key]" class="form-select">
                            @foreach (var b in ThemeCatalog.ButtonStyles)
                            {
                                <option value="@b.Key" selected="@(string.Equals(s.Value, b.Key, StringComparison.OrdinalIgnoreCase))">@b.Label</option>
                            }
                        </select>
                    }
                    else if (s.Key is "Payment.EnableCod" or "Payment.EnableOnlineGateway")
                    {
                        var isEnabled = !string.Equals(s.Value, "false", StringComparison.OrdinalIgnoreCase);
                        <select name="values[@s.Key]" class="form-select">
                            <option value="true" selected="@isEnabled">Enabled</option>
                            <option value="false" selected="@(!isEnabled)">Disabled</option>
                        </select>
                    }
                    else if (s.Key == "Tax.Rate")
                    {
                        <div class="input-group" style="max-width:200px">
                            <input name="values[@s.Key]" value="@s.Value" type="number" step="0.01" min="0" max="100" class="form-control" />
                            <span class="input-group-text">%</span>
                        </div>
                    }
                    else
                    {
                        <input name="values[@s.Key]" value="@s.Value" class="form-control" />
                    }

                    @if (!string.IsNullOrEmpty(s.Description))
                    {
                        <p class="field-hint">@s.Description</p>
                    }
                </div>
            }
        </div>
    }
    <button type="submit" class="btn btn-primary"><icon name="save" class="icon--sm" /> Save all settings</button>
</form>
