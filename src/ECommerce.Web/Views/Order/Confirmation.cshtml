@model ECommerce.Application.Orders.OrderDto
@{
    ViewData["Title"] = $"Order {Model.OrderNumber} confirmed";
}

<div class="page">
    <div class="container-x" style="max-width: 820px;">
        <div class="confirm-hero">
            <div class="confirm-check"><icon name="check" class="icon--lg" /></div>
            <h1>Thank you! Your order is confirmed.</h1>
            <p>Order <strong>@Model.OrderNumber</strong> · placed @Model.PlacedAt.ToString("MMMM d, yyyy")</p>
            @if (Model.PaymentMethod == ECommerce.Domain.Enums.PaymentMethodType.CashOnDelivery)
            {
                <p class="text-muted">You'll pay <strong>Cash on Delivery</strong> when it arrives.</p>
            }
            else
            {
                <p class="text-muted">Payment received — <strong>@Model.PaymentStatus</strong>.</p>
            }
        </div>

        <div class="panel">
            <h2 class="text-card-title mb-3">Items</h2>
            <partial name="_OrderSummary" model="Model" />
        </div>

        <div class="panel">
            <h2 class="text-card-title mb-3">Delivering to</h2>
            <p class="mb-1"><strong>@Model.ShippingName</strong> · @Model.ShippingPhone</p>
            <p class="mb-0 text-muted">@Model.ShippingOneLine</p>
        </div>

        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-controller="Account" asp-action="OrderDetail" asp-route-orderNumber="@Model.OrderNumber">View order</a>
            <a class="btn btn-ghost" href="/">Continue shopping</a>
        </div>
    </div>
</div>
