@model ECommerce.Web.ViewComponents.SiteFooterViewModel
@inject ECommerce.Application.Common.Features.IFeatureFlagService Features
@{
    var s = Model.Settings;
    var newsletterOn = await Features.IsEnabledAsync(ECommerce.Application.Common.Features.FeatureFlagKeys.Newsletter);
}

<footer class="site-footer">
    <div class="container-x">
        <div class="footer-grid">
            <div class="footer-col footer-brand">
                <div class="footer-brand__name">@s.SiteName</div>
                <p class="mb-0">@s.Tagline</p>
                <div class="footer-contact">
                    @if (!string.IsNullOrEmpty(s.ContactAddress))
                    {
                        <span>
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            @s.ContactAddress
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(s.ContactPhone))
                    {
                        <span>
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1.2.4 2.4.8 3.5a2 2 0 0 1-.5 2.1L8.1 10.5a16 16 0 0 0 6 6l1.2-1.3a2 2 0 0 1 2.1-.5c1.1.4 2.3.7 3.5.8a2 2 0 0 1 1.7 2z"/></svg>
                            <a href="tel:@s.ContactPhone.Replace(" ", "")">@s.ContactPhone</a>
                        </span>
                    }
                    @if (!string.IsNullOrEmpty(s.ContactEmail))
                    {
                        <span>
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/></svg>
                            <a href="mailto:@s.ContactEmail">@s.ContactEmail</a>
                        </span>
                    }
                </div>
                <div class="social-row">
                    @if (!string.IsNullOrEmpty(s.Facebook))
                    {
                        <a href="@s.Facebook" aria-label="Facebook" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M13 22v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3V2h-3a5 5 0 0 0-5 5v3H6v4h3v8z"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(s.Instagram))
                    {
                        <a href="@s.Instagram" aria-label="Instagram" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
                        </a>
                    }
                    @if (!string.IsNullOrEmpty(s.Twitter))
                    {
                        <a href="@s.Twitter" aria-label="Twitter" target="_blank" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.5 8.6L23 22h-6.9l-5.4-7-6.2 7H1.4l8-9.2L1 2h7l4.9 6.5zM17.7 20l1.7-.1L7.1 4H5.3z"/></svg>
                        </a>
                    }
                </div>
            </div>

            <div class="footer-col">
                <h5>Shop</h5>
                <ul>
                    <li><a href="/">Home</a></li>
                    @foreach (var c in Model.TopCategories)
                    {
                        <li><a href="/c/@c.Slug">@c.Name</a></li>
                    }
                    <li><a href="/deals">Deals</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h5>Customer Service</h5>
                <ul>
                    <li><a asp-controller="Account" asp-action="Orders">My Account</a></li>
                    <li><a asp-controller="Order" asp-action="Track">Track Order</a></li>
                    <li><a asp-controller="Home" asp-action="Shipping">Shipping &amp; Returns</a></li>
                    <li><a asp-controller="Home" asp-action="Faq">FAQ</a></li>
                    <li><a asp-controller="Home" asp-action="Contact">Contact Us</a></li>
                    <li><a asp-controller="Home" asp-action="AboutUs">About Us</a></li>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    <li><a asp-controller="Home" asp-action="Terms">Terms &amp; Conditions</a></li>
                </ul>
            </div>

            @if (newsletterOn)
            {
                <div class="footer-col newsletter">
                    <h5>Stay in the loop</h5>
                    <p class="mb-0">Subscribe for new arrivals, exclusive offers and more.</p>
                    <form data-newsletter-form method="post" action="/api/newsletter">
                        <input type="email" name="email" placeholder="Your email address" aria-label="Email address" required />
                        <button type="submit" class="btn btn-primary">Subscribe</button>
                    </form>
                    <small class="text-secondary d-block mt-2" data-newsletter-msg></small>
                </div>
            }
        </div>
    </div>

    <div class="container-x">
        <div class="trust-strip">
            <div class="trust-strip__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
                <span>Secure checkout</span>
            </div>
            <div class="trust-strip__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                <span>Cash on delivery</span>
            </div>
            <div class="trust-strip__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9 9 0 0 0-9 9z"/><path d="M12 7v5l3 3"/></svg>
                <span>7-day easy returns</span>
            </div>
            <div class="trust-strip__item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 3 7v6c0 5 3.8 8.5 9 10 5.2-1.5 9-5 9-10V7z"/></svg>
                <span>Buyer protection</span>
            </div>
        </div>

        <div class="footer-bottom">
            <span>&copy; @Model.Year @s.SiteName. All rights reserved.</span>
            <span class="payment-badges">
                <span>VISA</span><span>MASTERCARD</span><span>BKASH</span><span>COD</span>
            </span>
        </div>
    </div>
</footer>
