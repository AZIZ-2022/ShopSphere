@model IReadOnlyList<ECommerce.Application.Catalog.ProductListItemDto>

@if (Model.Count > 0)
{
    <div class="product-row">
        @foreach (var p in Model)
        {
            <div class="product-row__item">
                <partial name="_ProductCard" model="p" />
            </div>
        }
    </div>
}
