{
  "ConnectionStrings": {
   "DefaultConnection": "Server=DESKTOP-PUSPUGC;Database=ECommerceDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "DatabaseInitialization": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "Payment": {
    "Gateway": "Fake",
    "Fake": {
      "SimulateSuccess": true,
      "DeclineCardSuffix": "0000"
    },
    "SslCommerz": {
      "StoreId": "",
      "StorePassword": "",
      "Sandbox": true
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
